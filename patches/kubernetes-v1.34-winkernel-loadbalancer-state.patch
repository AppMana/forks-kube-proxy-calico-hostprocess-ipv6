+		testNodeName,
+		netutils.ParseIPSloppy("fd00::1"),
+		healthcheck.NewFakeServiceHealthServer(),
+		nil,
+		0,
+		hcnMock,
+		&testHostMacProvider{macAddress: macAddress},
+		config,
+		false,
+	)
+
+	assert.Nil(t, proxier)
+	assert.ErrorIs(t, err, errUnsupportedNetworkIPFamily)
+}
