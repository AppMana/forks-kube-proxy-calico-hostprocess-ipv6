+func getNetworkIPFamilySupport(hnsnetwork *hcn.HostComputeNetwork) (supportsIPv4, supportsIPv6, known bool) {
+	for _, ipam := range hnsnetwork.Ipams {
+		for _, subnet := range ipam.Subnets {
+			ip, _, err := net.ParseCIDR(subnet.IpAddressPrefix)
+			if err != nil {
+				continue
+			}
+			known = true
+			if ip.To4() != nil {
+				supportsIPv4 = true
+			} else {
+				supportsIPv6 = true
+			}
+		}
+	}
+	return supportsIPv4, supportsIPv6, known
+}
