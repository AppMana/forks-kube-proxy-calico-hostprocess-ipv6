# Local-build variant of Dockerfile.
#
# Simplest possible image: extend the upstream sigwindowstools/kube-proxy
# image and overlay our patched start.ps1. This avoids:
#   - The cross-platform Linux curl stage (Windows-only buildkit can't run it)
#   - Re-importing kube-proxy.exe as a fresh layer (Windows snapshotter rejects
#     it with "configuration registry database is corrupt" error 0x3f1 on
#     chained COPY operations of large binaries)
#
# Result: a single-COPY image whose only diff vs upstream is start.ps1.

ARG UPSTREAM="docker.io/sigwindowstools/kube-proxy:v1.34.6-calico-hostprocess"

FROM $UPSTREAM

COPY start.ps1 /kube-proxy/start.ps1
